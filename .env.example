# ── SERVER ─────────────────────────────────
PORT=3000
BASE_URL=https://your-domain.com        # public URL (for shareable links)

# ── ADMIN DASHBOARD ─────────────────────────
ADMIN_PASSWORD=change-me                # protects /admin?key=...

# ── OPTIONAL: WhatsApp Business API ─────────
# If left blank the app falls back to wa.me deep-links (works without a key)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
